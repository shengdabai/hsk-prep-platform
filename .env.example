# ───────────────────────────────────────────────────────────────
# HSK Prep Platform — 环境变量样板
# 用法:cp .env.example apps/web/.env.local 然后填入真实值
# 注意:本文件只放占位符,严禁提交真实密钥。
# ───────────────────────────────────────────────────────────────

# [必填-生产] 会话签名密钥(HMAC)。生产环境必须设置且 ≥32 字符,否则拒绝启动。
# 生成:openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# [可选] Supabase。演示模式下留空走内存 mock;接入后走真实持久化。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# [可选] Stripe。未配置时计费走骨架响应;配置后 webhook 落订阅并开通 entitlement。
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET
STRIPE_PRICE_PRO_MONTHLY=price_YOUR_PRICE_ID
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [可选] AI 内容生产引擎。
# 文本出题:DeepSeek
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY
# 考试配图:OpenAI GPT Image 2
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_IMAGE_MODEL=gpt-image-2
# 听力 + 口语语音:Minimax
MINIMAX_API_KEY=YOUR_MINIMAX_KEY
MINIMAX_GROUP_ID=YOUR_MINIMAX_GROUP_ID
